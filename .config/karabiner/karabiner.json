{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "アプリケーション切替。⌘ + 数字で起動。1: Browser, 2: Editor, 3: Terminal (like a Snap app)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "1",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "shell_command": "open -a '/Applications/Google Chrome.app/'" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "2",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "shell_command": "open -a '/Applications/Visual Studio Code.app/'" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "3",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [{ "shell_command": "open -a '/Applications/iTerm.app/'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "右Optionキーを押したときにCommand+Shift+5を送信する",
                        "manipulators": [
                            {
                                "from": { "key_code": "right_option" },
                                "to": [
                                    {
                                        "key_code": "5",
                                        "modifiers": ["left_command", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "コマンドキーを単体で押したときに、英数・かなキーを送信する。（左コマンドキーは英数、右コマンドキーはかな） (rev 2)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_command",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "japanese_eisuu" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "right_command",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "japanese_kana" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
